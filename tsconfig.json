{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2023"],
		"module": "es2022",
		"moduleResolution": "bundler",
		"types": ["./worker-configuration.d.ts", "node"],
		"resolveJsonModule": true,
		"noEmit": true,
		"isolatedModules": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["src", "test", "worker-configuration.d.ts"]
}
